# Windows embeddable Python runtime — downloaded by setup.bat, never committed.
# ponytail: NEVER put a trailing comment on a pattern line — git treats the
# whole line as the pattern ("python/  # comment" matches nothing), which is
# exactly how site-packages once nearly got committed wholesale.
python/

*.bak
.DS_Store

# USB-AI audit fix 2026-08-07: exclude embeddable install, runtime logs, Windows-generated desktop.ini
models/desktop.ini

python_install*.log

# Claude Code local settings — machine-specific by design, never commit
.claude/settings.local.json

# Agent-tooling scratch caches (never part of the app)
.utim_tmp/
